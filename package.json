{
  "name": "vtt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "description": "Serverless browser-only Virtual Tabletop \u2014 single self-contained index.html (host = GM tab)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "size": "node scripts/size.mjs",
    "build:systems": "node scripts/buildSystemPackages.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "mqtt": "^5.15.2",
    "nostr-tools": "^2.25.2",
    "pixi.js": "^8.20.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
