+      const settled = settledScene?.tokens.find((item) => item._id === candidate.tokenId);
+      if (!settled) continue;
+      let stopPositionWrites = 0;
+      const stopOnly = outcome.plan.ops.every((op) => {
+        if (op.kind !== "update") return false;
