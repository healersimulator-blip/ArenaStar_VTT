+
+  test("resolves ordinary world-relative references to journals, pages, actors, and scenes", () => {
+    const journal = sheet("j1");
+    const actorDoc = actor("a1", 1);
+    const sceneDoc = scene("s1");
+    const world = {
+      journals: [journal],
+      actors: [actorDoc],
+      scenes: [sceneDoc],
+      items: [],
+      users: [],
+      folders: [],
+      rollTables: [],
+      encounterTables: [],
+      playlists: [],
+      macros: [],
+      automations: [],
+      actionReceipts: [],
+      prefabs: [],
+      fxInstances: [],
+      cards: [],
+      combats: [],
+      messages: [],
+      settings: [],
+      compendia: [],
+      factions: [],
+      armies: [],
+      turns: [],
+      depots: [],
+      routes: [],
+      reinforcements: [],
+      assetManifest: {},
+    } as never;
+    expect(resolveCodexWorldRef(world, { coll: "journals", id: "j1" })).toBe(
+      journal,
+    );
+    expect(
+      resolveCodexWorldRef(world, {
+        coll: "pages",
+        id: "j1-page",
+        parent: { coll: "journals", id: "j1" },
