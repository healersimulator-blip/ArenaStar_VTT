+  entry: PF1eQuickbarEntry;
+  scene: SceneDocument;
+  casterTokenId: string;
+  origin: { x: number; y: number };
+  direction: { x: number; y: number };
+  targets: readonly { tokenId: string; actor: ActorDocument }[];
+  effectMacroId?: string;
