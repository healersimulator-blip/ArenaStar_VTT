diff --git a/tests/core/lightAnimation.test.ts b/tests/core/lightAnimation.test.ts
new file mode 100644
index 0000000..53ebd6c
--- /dev/null
+++ b/tests/core/lightAnimation.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, test } from "vitest";
+import { lightAnimationAlpha, parseLightAnimation } from "../../src/core/lightAnimation";
+
+describe("declarative light animation metadata", () => {
+  test("accepts the bounded built-in effects and keeps only the typed contract", () => {
+    expect(parseLightAnimation({ type: "torch", speed: 4.1, intensity: 0.32 })).toEqual({
+      ok: true,
+      value: { type: "torch", speed: 4.1, intensity: 0.32 },
+    });
+    expect(parseLightAnimation({ type: "pulse", speed: 0, intensity: 1, reverse: true })).toEqual({
+      ok: true,
+      value: { type: "pulse", speed: 0, intensity: 1, reverse: true },
+    });
+    expect(parseLightAnimation(null)).toEqual({ ok: true, value: null });
+  });
+
+  test.each([
+    [{ type: "arbitrary-js", speed: 1, intensity: 1 }, "light animation type must be torch or pulse"],
+    [{ type: "torch", speed: 10.1, intensity: 0.5 }, "light animation speed must be between 0 and 10 cycles per second"],
+    [{ type: "pulse", speed: 1, intensity: 1.1 }, "light animation intensity must be between 0 and 1"],
+    [{ type: "pulse", speed: 1, intensity: 0.5, reverse: "yes" }, "light animation reverse must be a boolean"],
+    [{ type: "pulse", speed: 1, intensity: 0.5, script: "run()" }, "light animation contains an unsupported field"],
+  ])("rejects invalid or executable metadata %#", (value, error) => {
+    expect(parseLightAnimation(value)).toMatchObject({ ok: false, error });
+  });
+
+  test("pulse animates presentation deterministically, while reduced motion and zero depth stay static", () => {
+    const animation = { type: "pulse" as const, speed: 1, intensity: 1 };
+    expect(lightAnimationAlpha(animation, 0)).toBeCloseTo(0.81);
+    expect(lightAnimationAlpha(animation, 0.25)).toBe(1);
+    expect(lightAnimationAlpha(animation, 0, true)).toBe(1);
+    expect(lightAnimationAlpha({ ...animation, intensity: 0 }, 0.25)).toBe(1);
+    expect(lightAnimationAlpha({ ...animation, reverse: true }, 0.25)).toBeCloseTo(0.62);
+  });
+});
diff --git a/tests/core/openingSightPolicy.test.ts b/tests/core/openingSightPolicy.test.ts
new file mode 100644
index 0000000..3b2922b
--- /dev/null
+++ b/tests/core/openingSightPolicy.test.ts
@@ -0,0 +1,107 @@
+/** Scene-level proximity LOS defaults, overrides, validation and wire compatibility. */
+import { describe, expect, test } from "vitest";
+import type { Json, LevelDocument, SceneDocument, WallDocument } from "../../src/core/documents";
+import {
+  defaultOpeningSightPolicy,
+  levelApertureSightOverrideOp,
+  openingSightConeAt,
+  openingSightCurveError,
+  openingSightOverrideError,
+  openingSightPolicyError,
+  openingSightWorldDataError,
+  sceneOpeningSightPolicyOp,
+  wallOpeningSightOverrideOp,
+  type OpeningSightCurve,
+  type SceneOpeningSightPolicy,
+} from "../../src/core/openingSightPolicy";
+import { OPENING_SIGHT_FEATURE, opsNeedOpeningSight, requiredOpFeatures, requiredWorldFeatures } from "../../src/core/capabilities";
+import { openingSightTransactionError } from "../../src/core/openingSightPolicy";
+
+const curve: OpeningSightCurve = {
+  partialAt: 30,
+  partial: { depth: 10, widthDeg: 20 },
+  fullAt: 10,
+  full: { depth: 50, widthDeg: 100 },
+};
+const policy: SceneOpeningSightPolicy = {
+  enabled: true,
+  applyTo: { windows: true, doors: true, apertures: false },
+  ...curve,
+};
+
+function wall(over: Partial<WallDocument> = {}): WallDocument {
+  return {
+    _id: "wall-1", type: "wall", name: "Window", ownership: { default: 2 }, flags: {}, system: {},
+    c: [100, 0, 100, 200], door: 0, oneWay: false, move: 0, sight: 2, sound: 0, light: 2,
+    ...over,
+  };
+}
+
+describe("opening-sight policy", () => {
+  test("legacy scenes default Off with grid-relative editable defaults", () => {
+    expect(defaultOpeningSightPolicy({ distance: 10 })).toEqual({
+      enabled: false,
+      applyTo: { windows: true, doors: true, apertures: true },
+      partialAt: 60,
+      partial: { depth: 20, widthDeg: 35 },
+      fullAt: 10,
+      full: { depth: 120, widthDeg: 120 },
+    });
+    expect(openingSightPolicyError(undefined)).not.toBeNull();
+  });
+
+  test("validates the two-keyframe cone and linearly interpolates depth and width", () => {
+    expect(openingSightCurveError(curve)).toBeNull();
+    expect(openingSightConeAt(curve, 40)).toBeNull();
+    expect(openingSightConeAt(curve, 30)).toEqual(curve.partial);
+    expect(openingSightConeAt(curve, 20)).toEqual({ depth: 30, widthDeg: 60 });
+    expect(openingSightConeAt(curve, 10)).toEqual(curve.full);
+    expect(openingSightCurveError({ ...curve, partialAt: 10 })).toMatch(/greater/);
+    expect(openingSightCurveError({ ...curve, partial: { depth: 51, widthDeg: 20 } })).toMatch(/cannot be deeper/);
+  });
+
+  test("local full/custom overrides are sparse, validated and removable", () => {
+    expect(openingSightOverrideError({ mode: "full" })).toBeNull();
+    expect(openingSightOverrideError({ mode: "custom", curve })).toBeNull();
+    expect(openingSightOverrideError({ mode: "inherit" })).toMatch(/inherit by removing/);
+    expect(wallOpeningSightOverrideOp("scene-1", "wall-1", null).diff).toEqual({ "-=openingSightOverride": null });
+    expect(wallOpeningSightOverrideOp("scene-1", "wall-1", { mode: "full" }).diff).toEqual({ openingSightOverride: { mode: "full" } });
+
+    const level = { _id: "upper", apertureSightOverrides: { "ap-0123456789abcdef": { mode: "full" as const } } };
+    expect(levelApertureSightOverrideOp("scene-1", level, "ap-1111111111111111", { mode: "custom", curve }).diff)
+      .toEqual({ apertureSightOverrides: { ...level.apertureSightOverrides, "ap-1111111111111111": { mode: "custom", curve } } });
+    expect(levelApertureSightOverrideOp("scene-1", level, "ap-0123456789abcdef", null).diff)
+      .toEqual({ "-=apertureSightOverrides": null });
+  });
+
+  test("scene writes preserve unrelated flags and world validation rejects malformed policy data", () => {
+    const op = sceneOpeningSightPolicyOp({ _id: "scene-1", flags: { core: { scale: "strategic" }, module: { other: true } } }, policy);
+    expect(op.diff.flags).toMatchObject({ core: { scale: "strategic", openingSight: policy }, module: { other: true } });
+    expect(openingSightWorldDataError({ flags: { core: { openingSight: policy as unknown as Json } }, walls: [wall()] })).toBeNull();
+    expect(openingSightWorldDataError({ flags: { core: { openingSight: { ...policy, enabled: "yes" } as unknown as Json } } })).toMatch(/enabled/);
+    expect(openingSightWorldDataError({ flags: {}, walls: [wall({ openingSightOverride: { mode: "custom", curve: { ...curve, partialAt: 1 } } })] })).toMatch(/greater/);
+  });
+
+  test("the host validates final wall overrides, and new data declares the wire feature", () => {
+    const existing = wall();
+    const ref = { coll: "walls" as const, id: existing._id, parent: { coll: "scenes" as const, id: "scene-1" } };
+    const resolve = () => existing;
+    expect(openingSightTransactionError([
+      { kind: "update", ref, diff: { openingSightOverride: { mode: "custom", curve: { ...curve, fullAt: 40 } } as never } },
+    ], resolve)).toMatch(/greater/);
+    const valid = wallOpeningSightOverrideOp("scene-1", existing._id, { mode: "full" });
+    expect(openingSightTransactionError([valid], resolve)).toBeNull();
+
+    const setting = { kind: "update" as const, ref: { coll: "scenes" as const, id: "scene-1" }, diff: { flags: { core: { openingSight: policy as unknown as Json } } } };
+    const wallOverride = wallOpeningSightOverrideOp("scene-1", existing._id, { mode: "full" });
+    expect(opsNeedOpeningSight([setting])).toBe(true);
+    expect(opsNeedOpeningSight([wallOverride])).toBe(true);
+    expect(requiredOpFeatures([setting])).toContain(OPENING_SIGHT_FEATURE);
+    const scene = { _id: "scene-1", type: "scene", flags: { core: { openingSight: policy as unknown as Json } } } as unknown as SceneDocument;
+    expect(requiredWorldFeatures([scene], "PLAYER")).toContain(OPENING_SIGHT_FEATURE);
+    expect(requiredWorldFeatures([scene], "GM")).toContain(OPENING_SIGHT_FEATURE);
+
+    const draftLevel = { _id: "upper", apertureSightOverrides: { "ap-0123456789abcdef": { mode: "full" } } } as unknown as LevelDocument;
+    expect(opsNeedOpeningSight([{ kind: "create", coll: "levels", parent: { coll: "scenes", id: "scene-1" }, data: draftLevel }])).toBe(true);
+  });
+});
diff --git a/tests/core/proximityCrossFloorSight.test.ts b/tests/core/proximityCrossFloorSight.test.ts
new file mode 100644
index 0000000..ba9164b
--- /dev/null
+++ b/tests/core/proximityCrossFloorSight.test.ts
@@ -0,0 +1,115 @@
+/** Cross-floor LOS policy for traced floor apertures and scoped wall openings. */
+import { describe, expect, test } from "vitest";
+import type { Json, LevelDocument, LevelSurface, SceneDocument, TokenDocument, WallDocument } from "../../src/core/documents";
+import { surfaceApertures } from "../../src/core/floorSurface";
+import { draftLevel } from "../../src/core/levels";
+import { tokensSeenBelow } from "../../src/core/crossFloorSight";
+import { wallFieldsFor } from "../../src/canvas/vision/wallKinds";
+import type { SceneOpeningSightPolicy } from "../../src/core/openingSightPolicy";
+
+const player = { id: "player", role: "PLAYER" as const };
+const base = { flags: {}, system: {} };
+const policy: SceneOpeningSightPolicy = {
+  enabled: true,
+  applyTo: { windows: true, doors: true, apertures: true },
+  partialAt: 20,
+  partial: { depth: 0, widthDeg: 180 },
+  fullAt: 5,
+  full: { depth: 40, widthDeg: 180 },
+};
+const squareSurface: LevelSurface = {
+  x: 0, y: 0, width: 1000, height: 1000, source: "drawn",
+  footprint: {
+    version: 2,
+    components: [{
+      outer: [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }, { x: 0, y: 1 }],
+      holes: [[{ x: 0.4, y: 0.4 }, { x: 0.6, y: 0.4 }, { x: 0.6, y: 0.6 }, { x: 0.4, y: 0.6 }]],
+    }],
+  },
+};
+
+const token = (id: string, levelId: string, x: number, y: number, z: number, over: Partial<TokenDocument> = {}): TokenDocument => ({
+  ...base, _id: id, type: "token", name: id, ownership: { default: 2 }, x, y, width: 100, height: 100, rotation: 0,
+  elevation: z, levelId, img: "", vision: false, hidden: false, disposition: "hostile",
+  light: { radius: 0, color: "#fff", alpha: 0 }, ...over,
+});
+const hero = (x: number, over: Partial<TokenDocument> = {}) => token("hero", "upper", x, 550, 10,
+  { ownership: { default: 2, player: 3 }, vision: true, disposition: "friendly", ...over });
+function scene(tokens: TokenDocument[], options: {
+  policy?: SceneOpeningSightPolicy;
+  upper?: Partial<LevelDocument>;
+  walls?: WallDocument[];
+} = {}): SceneDocument {
+  const ground = draftLevel("ground", "Ground", 0, 10, 0);
+  const upper: LevelDocument = {
+    ...draftLevel("upper", "Upper", 10, 20, 1), visibleLevelIds: ["ground"], surface: squareSurface,
+    ...options.upper,
+  };
+  return {
+    ...base, _id: "scene", type: "scene", name: "Room", ownership: { default: 2 }, active: true, img: null,
+    width: 1000, height: 1000, darkness: 0, levelMode: "isolated",
+    grid: { type: "square", size: 100, distance: 5, units: "ft", diagonals: "555", hexLayout: "oddQ" },
+    flags: options.policy ? { core: { openingSight: options.policy as unknown as Json } } : {},
+    levels: [ground, upper], tokens, walls: options.walls ?? [], lights: [], sounds: [], tiles: [], regions: [], drawings: [], templates: [], notes: [],
+  };
+}
+function scopedWall(kind: "window" | "door", state = 0 as 0 | 1 | 2, override?: WallDocument["openingSightOverride"]): WallDocument {
+  return {
+    ...base, _id: `${kind}-${state}`, type: "wall", name: kind, ownership: { default: 2 },
+    levelScope: { mode: "levels", ids: ["upper"] },
+    ...wallFieldsFor(kind, [390, 300, 390, 800], state),
+    ...(override ? { openingSightOverride: override } : {}),
+  };
+}
+
+describe("cross-floor proximity sight", () => {
+  const apertureId = surfaceApertures({ surface: squareSurface })[0]?.id;
+  if (!apertureId) throw new Error("test surface must contain its traced hole");
+
+  test("attenuates only a real traced aperture; legacy, disabled and local Full LOS preserve open passage", () => {
+    // The far observer's high target sample crosses the hole interior, but is more than the
+    // interpolated partial depth away from the lower target. Other samples cross solid floor.
+    const tokens = [hero(100), token("below", "ground", 827, 550, 0)];
+    expect(tokensSeenBelow(scene(tokens), [], player, "upper")).toEqual([{ id: "below", depth: 1 }]);
+    expect(tokensSeenBelow(scene(tokens, { policy: { ...policy, enabled: false } }), [], player, "upper")).toEqual([
+      { id: "below", depth: 1 },
+    ]);
+    expect(tokensSeenBelow(scene(tokens, { policy }), [], player, "upper")).toEqual([]);
+
+    const full = scene(tokens, { policy, upper: { apertureSightOverrides: { [apertureId]: { mode: "full" } } } });
+    expect(tokensSeenBelow(full, [], player, "upper")).toEqual([{ id: "below", depth: 1 }]);
+    const custom = scene(tokens, { policy: { ...policy, enabled: false }, upper: {
+      apertureSightOverrides: { [apertureId]: { mode: "custom", curve: {
+        partialAt: 100, partial: { depth: 30, widthDeg: 180 }, fullAt: 5, full: { depth: 40, widthDeg: 180 },
+      } } },
+    } });
+    expect(tokensSeenBelow(custom, [], player, "upper")).toEqual([{ id: "below", depth: 1 }]);
+
+  });
+
+  test("a scoped window or open door attenuates rays, while closed and locked doors stay blocked", () => {
+    const nearTokens = [hero(350), token("near", "ground", 550, 550, 0)];
+    const farTokens = [hero(100), token("far", "ground", 827, 550, 0)];
+    const wallOnlyPolicy = { ...policy, applyTo: { ...policy.applyTo, apertures: false } };
+    const window = scopedWall("window");
+    expect(tokensSeenBelow(scene(nearTokens, { policy: wallOnlyPolicy, walls: [window] }), [], player, "upper"))
+      .toEqual([{ id: "near", depth: 1 }]);
+    expect(tokensSeenBelow(scene(farTokens, { policy: wallOnlyPolicy, walls: [window] }), [], player, "upper"))
+      .toEqual([]);
+
+    const openDoor = scopedWall("door", 1);
+    expect(tokensSeenBelow(scene(nearTokens, { policy: wallOnlyPolicy, walls: [openDoor] }), [], player, "upper"))
+      .toEqual([{ id: "near", depth: 1 }]);
+    expect(tokensSeenBelow(scene(farTokens, { policy: wallOnlyPolicy, walls: [openDoor] }), [], player, "upper"))
+      .toEqual([]);
+
+    const forcedFullDoor = scopedWall("door", 1, { mode: "full" });
+    expect(tokensSeenBelow(scene(farTokens, { policy: wallOnlyPolicy, walls: [forcedFullDoor] }), [], player, "upper"))
+      .toEqual([{ id: "far", depth: 1 }]);
