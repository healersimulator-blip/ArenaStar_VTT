+        kind: "not-a-module",
+        packageId: lock.id,
+        message: `Enabled package ${lock.id} is not an AIS module`,
+        blocking: true,
+      });
+      continue;
+    }
+    if (pkg.version !== lock.version) {
+      issues.push({
+        kind: "version-mismatch",
+        packageId: lock.id,
+        message: `${lock.id} is locked to ${lock.version}, but ${pkg.version} is installed`,
+        blocking: true,
+      });
+      continue;
+    }
+    if (pkg.hash !== lock.hash) {
