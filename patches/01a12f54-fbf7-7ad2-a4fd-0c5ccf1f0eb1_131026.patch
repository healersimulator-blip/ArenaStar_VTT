+): SceneOpeningSightPolicy {
+  const core = scene?.flags?.["core"];
+  const stored = isRecord(core) ? core["openingSight"] : undefined;
+  if (openingSightPolicyError(stored)) return defaultOpeningSightPolicy(scene?.grid);
