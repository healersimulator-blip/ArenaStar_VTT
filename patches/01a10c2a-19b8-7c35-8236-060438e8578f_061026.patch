diff --git a/src/ui/chat/actionNarrative.ts b/src/ui/chat/actionNarrative.ts
new file mode 100644
index 0000000..abd07d5
--- /dev/null
+++ b/src/ui/chat/actionNarrative.ts
@@ -0,0 +1,65 @@
+/**
+ * F01/D-222 (re-affirmed for the D-405 action card, 2026-10-06) — **the narrative an action card
+ * still owes its reader.**
+ *
+ * An action card renders its own mechanics: the target rows, their `notes` and the action's
+ * `notes`/warnings (the last in a collapsed disclosure). The message's `content` is a *second*
+ * render of some of the same strings — the cast/save/damage sentences, plus `⚠`-prefixed copies of
+ * exactly those warnings, plus the resolver's own target note ("No saving throw is allowed …").
+ *
+ * Two failure modes sit on either side of that overlap, and both are real at this table:
+ *
+ * - rendering the content verbatim **repeats** the warnings and the target note (the reader sees
+ *   "1-level slots over budget" twice, once as a card note and once as a `⚠` line);
+ * - not rendering it at all **swallows the narrative** — which is how four specs caught the
+ *   version-2 card dropping "casts Magic Missile" and the hp line from the chat log (D-222's
+ *   original F01 defect, for `RollCard`, found again for `ActionCard`).
+ *
+ * So: keep every line the card *cannot* show, and drop only the ones it already does — and only
+ * when the two strings are **identical**. Comparison is whole-line after normalising away the `⚠`
+ * prefix, `[[total|formula]]` chips, internal whitespace and trailing punctuation; **case is
+ * significant**, because the flow's own narrative and the resolver's note are not always the same
+ * sentence ("No saving throw is allowed …" vs the target note "no saving throw is allowed …"), and
+ * a card must never assume two differently-worded sentences are redundant. A line that merely
+ * *begins* with a note's text is kept too: a note is not a prefix filter.
+ */
+
+/** A chip renders as its display half: `[[15|1d20 + 5]]` reads as `15`. */
+function withoutChips(line: string): string {
+  return line.replace(/\[\[([^\]|]*)(?:\|([^\]]*))?\]\]/gu, (_all, display: string, formula?: string) =>
+    formula === undefined ? display : display,
+  );
+}
+
+/** Notes/warnings as a card renders them: `⚠` prefix, stray whitespace, trailing periods gone. */
+function comparable(line: string): string {
+  return withoutChips(line)
+    .replace(/^\s*⚠\s*/u, "")
+    .replace(/\s+/gu, " ")
+    .replace(/[.\s]+$/u, "")
+    .trim();
+}
+
+/**
+ * The lines of `content` that an action card's own render does **not** already carry, in order.
+ * Returns `[]` for empty content (a card message may legitimately have none).
+ */
+export function actionCardNarrativeLines(
+  content: string,
+  renderedNotes: readonly string[],
+): string[] {
+  if (content.trim() === "") return [];
+  const shown = new Set<string>();
+  for (const note of renderedNotes) {
+    const key = comparable(note);
+    if (key !== "") shown.add(key);
+  }
+  const lines: string[] = [];
+  for (const raw of content.split("\n")) {
+    const line = raw.trim();
+    if (line === "") continue;
+    if (shown.has(comparable(line))) continue;
+    lines.push(line);
+  }
+  return lines;
+}
