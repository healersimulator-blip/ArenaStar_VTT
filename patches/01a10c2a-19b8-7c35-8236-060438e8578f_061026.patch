diff --git a/tests/ui/actionNarrative.test.ts b/tests/ui/actionNarrative.test.ts
new file mode 100644
index 0000000..cf09463
--- /dev/null
+++ b/tests/ui/actionNarrative.test.ts
@@ -0,0 +1,63 @@
+/**
+ * F01/D-222 for the D-405 action card — the narrative a card still owes its reader.
+ *
+ * The two failure modes are both historical: the chat swallowing a card's narrative (D-222's F01
+ * defect, fixed for `RollCard` and found again for `ActionCard` by four cast-flow specs), and a
+ * card repeating the warnings it already lists. Every case below is one of those two.
+ */
+import { describe, expect, test } from "vitest";
+import { actionCardNarrativeLines } from "../../src/ui/chat/actionNarrative";
+
+describe("an action card's narrative (F01/D-222)", () => {
+  test("keeps the lines the card cannot render, in order", () => {
+    const content = [
+      "PF Wizard casts Magic Missile (level 1) at PF Ogre — DC 13.",
+      "No saving throw is allowed — the effect applies in full.",
+      "PF Ogre 20 → 12 HP.",
+    ].join("\n");
+    // The card renders *this* one as a target note; the other two exist nowhere else.
+    expect(actionCardNarrativeLines(content, ["No saving throw is allowed — the effect applies in full"]))
+      .toEqual([
+        "PF Wizard casts Magic Missile (level 1) at PF Ogre — DC 13.",
+        "PF Ogre 20 → 12 HP.",
+      ]);
+  });
+
+  test("a ⚠ warning the card already lists is not printed twice", () => {
+    // The same string goes to the card's `notes` and to the content with a ⚠ prefix and a period.
+    const content = [
+      "PF Wizard casts Breeze (level 1) at PF Ogre — DC 13.",
+      "⚠ 1-level slots over budget: 6 spent of 5 available.",
+    ].join("\n");
+    expect(
+      actionCardNarrativeLines(content, ["1-level slots over budget: 6 spent of 5 available"]),
+    ).toEqual(["PF Wizard casts Breeze (level 1) at PF Ogre — DC 13."]);
+  });
+
+  test("comparison is whole-line and case-sensitive: a note is never a prefix filter", () => {
+    const content = "Entangled: the target is entangled and cannot move freely.";
+    // A note that shares a prefix must not swallow the longer narrative sentence.
+    expect(actionCardNarrativeLines(content, ["Entangled: the target is entangled"])).toEqual([
+      content,
+    ]);
+    // Nor may a differently-cased sentence be assumed redundant: the cast flow's narrative and the
+    // resolver's target note are exactly this pair ("No saving throw …" vs "no saving throw …"),
+    // and the narrative is the one the four cast-flow specs assert on.
+    expect(
+      actionCardNarrativeLines("No saving throw is allowed — the effect applies in full.", [
+        "no saving throw is allowed — the effect applies in full",
+      ]),
+    ).toEqual(["No saving throw is allowed — the effect applies in full."]);
+    // The *same* sentence, with only whitespace/punctuation noise, is dropped.
+    for (const same of [content, `${content}  `, content.replace(/\.$/u, "")]) {
+      expect(actionCardNarrativeLines(content, [same])).toEqual([]);
+    }
+  });
+
+  test("chips compare as their display half, and empty content renders nothing", () => {
+    const content = "SR check [[15|1d20 + caster level]] — overcome.";
+    expect(actionCardNarrativeLines(content, ["SR check 15 — overcome"])).toEqual([]);
+    expect(actionCardNarrativeLines("", ["anything"])).toEqual([]);
+    expect(actionCardNarrativeLines("\n  \n", [])).toEqual([]);
+  });
+});
