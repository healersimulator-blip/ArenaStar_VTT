+++ b/modules/foundry-tagger/README.md
@@ -0,0 +1,31 @@
+# Original Tagger 1.5.4 — AIS feasibility guest
+
+The three executable files in `upstream/scripts/` are preserved byte-for-byte from:
+
+- Repository: https://github.com/fantasycalendar/FoundryVTT-Tagger
+- Tag: `1.5.4`
+- Commit: `e7936bc9ee01e4445624fbc82a11e887e5cd0075`
+- Notice: `upstream/LICENSE` (MIT, Fantasy Computerworks).
+
+`PROVENANCE.json` records SHA-256 file digests. The preparation script verifies these before
+bundling. `upstream/module.json` is the source-tree manifest, including its original build-time
+version placeholder. The executable source is rebundled locally; this is NOT represented as an
+untouched published release ZIP. Unused upstream documentation images are not bundled.
+
+`automation/commands.js` is ArenaStar-authored binding code. It calls the original `Tagger` methods;
+our native Tagger-style query implementation does not answer these searches or expand their rules.
+The guest requires separately enabled/approved `ais-foundry-v13`. Both are ordinary world ZIP
+contents; approvals never travel in a world export.
+
+Declared commands:
+
+- `info`, `find`, `set-tags`, `add-tags`, `clear-tags`, `apply-rules`.
+- `veto-test`: demonstrate that a local pre-update veto makes no host write.
+- `fx-demo`: exercise the adapter's native-backed Sequence API substitute. Upstream Tagger does
+  not itself depend on Sequencer; this additional demonstration is explicitly our binding code.
+
+Scope: non-hidden placeables in the currently viewed scene, local GM invocation, tag-only writes.
+No Foundry forms/hotkeys, world actors, other scenes, native pre-create integration or player
+execution. Numbered rules apply to this authorized view, not to hidden/global tag namespaces.
+
+Build/run instructions are in the repository's `AIS_FOUNDRY_FEASIBILITY.md`.
diff --git a/modules/foundry-tagger/automation/commands.js b/modules/foundry-tagger/automation/commands.js
new file mode 100644
index 0000000..cf5ba66
--- /dev/null
+++ b/modules/foundry-tagger/automation/commands.js
@@ -0,0 +1,46 @@
+/* ArenaStar command bindings. Tag searches/rule expansion are performed by the ORIGINAL
+ * upstream Tagger class, not by our native Tagger-style query implementation. */
+(function () {
+  "use strict";
+  const invoke = (id, callback) => AIS.commands.on(id, (input, context) =>
+    FoundryAdapter.invoke(context, () => callback(input, context)));
+  const target = (input) => {
+    const document = game.canvas.scene.tokens.get(input.tokenId);
+    if (!document) throw new Error("Token is outside this visible scene projection");
+    return document;
+  };
+  invoke("info", () => ({ ...FoundryAdapter.info(), realTagger: typeof Tagger.getByTag === "function" }));
+  invoke("find", (input) => {
+    if (input.allScenes) throw new Error("All-scene search is outside this profile");
+    return Tagger.getByTag(input.tags, { matchAny: input.matchAny === true, matchExactly: input.matchExactly === true,
+      caseInsensitive: input.caseInsensitive === true }).map((doc) => ({ id: doc.id, name: doc.name, uuid: doc.uuid, tags: Tagger.getTags(doc) }));
+  });
+  for (const [id, method] of [["set-tags", "setTags"], ["add-tags", "addTags"], ["clear-tags", "clearAllTags"], ["apply-rules", "applyTagRules"]]) {
+    invoke(id, async (input) => {
+      const doc = target(input);
+      await Tagger[method](doc, input.tags);
+      return { id: doc.id, tags: Tagger.getTags(doc) };
+    });
+  }
+  invoke("veto-test", async (input) => {
+    const id = Hooks.on("preUpdateToken", () => false);
+    try { await Tagger.addTags(target(input), ["must-not-commit"]); }
+    catch (error) {
+      if (error.message !== "Document update vetoed by a pre-hook") throw error;
+      return { vetoed: true, message: error.message, tags: Tagger.getTags(target(input)) };
+    }
+    finally { Hooks.off("preUpdateToken", id); }
+    throw new Error("Expected pre-update veto");
+  });
+  // This explicitly demonstrates our API SUBSTITUTE over the existing native FX engine.
+  // It is not a claim that upstream Tagger itself depends on Sequencer.
+  invoke("fx-demo", async (input, context) => {
+    const doc = target(input);
+    const sequence = new Sequence().effect().text("AIS connected").atLocation(doc).name("ais-feasibility")
+      .duration(350).fadeIn(50).fadeOut(100).waitUntilFinished(-100)
+      .effect().text("Native FX").atLocation(doc).duration(250);
+    const run = await sequence.play();
+    return { ...run, nativeFx: true,
+      activeOwnRuns: (await context.ais.fx.list()).length };
+  });
+})();
