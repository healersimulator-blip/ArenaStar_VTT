+    await waitForSurface(page, "app");
+    await expect.poll(readLight).toEqual({ radius: 40 * target.pixelsPerFoot, animation: "torch", quantity: 1 });
+    await menu("off");
+    await expect.poll(async () => (await readLight()).radius).toBe(0);
+    await menu("toggle");
+    await expect.poll(readLight).toEqual({ radius: 40 * target.pixelsPerFoot, animation: "torch", quantity: 1 });
+  });
+}
