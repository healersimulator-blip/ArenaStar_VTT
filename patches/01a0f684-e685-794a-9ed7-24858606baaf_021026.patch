+    result: string;
+    detail: string;
+    selectedTargets: number | null;
+    sequence: number | null;
+    traceEntries: number;
+  }>>(page, "app", "a41RunSimpleTriggers", [{ sceneId: fixture.sceneId, tileId: fixture.triggerTileId,
+    automationId: fixture.clickAutomationId, count: 100 }]);
